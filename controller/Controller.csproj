<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Desktop3D.Controller</AssemblyName>
    <RootNamespace>Desktop3D.Controller</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Streamlined Desktop Overlay for Windows (SLW3D)</Product>
    <Company>Vkng137</Company>
    <Description>SLW3D tray controller, global hotkeys, and game mode watcher.</Description>
    <ApplicationIcon>..\assets\desktop3d.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\common\*.cs" Link="common\%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Desktop3D.Tests" />
  </ItemGroup>

</Project>
